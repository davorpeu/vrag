ES_URL=http://localhost:9200
ES_INDEX=vrag-chunks

OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text
EMBED_DIMS=768

# Matches LANGFUSE_INIT_* in docker-compose.yml
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev

API_URL=http://localhost:8000

# Document store for the "db" source (docs-db in docker-compose.yml)
DOCS_DB_URL=postgresql://vrag:vrag@127.0.0.1:5433/docs

# Object store for the "s3" source (docs-minio in docker-compose.yml)
DOCS_S3_URL=http://127.0.0.1:9100
DOCS_S3_ACCESS_KEY=vrag
DOCS_S3_SECRET_KEY=vrag-minio-secret
DOCS_S3_BUCKET=vrag-docs

# Reranker (optional): a local cross-encoder reorders the top fused hits (src/vrag/rerank.py).
# Off by default: it adds ~0.8 GB RAM and ~1.5 s per search (see agents/runs/2026-11-20/reports/W2.md).
# Model files download once into MODELS_DIR (gitignored).
RERANK=false
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20
MODELS_DIR=data/models
